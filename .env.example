# Copy to .env and adjust. Every value is optional; defaults run fully locally.

# --- LLM (script writing). "ollama" (default), "anthropic", or "none" (extractive, no LLM) ---
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
# Scenes the LLM writes at the same time (each still passes the same verification)
LLM_PARALLEL=2
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Text to speech. "auto" picks piper > kokoro > espeak ---
TTS_PROVIDER=auto
PIPER_VOICE=models/piper/en_US-ljspeech-high.onnx
KOKORO_MODEL=models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES=models/kokoro/voices-v1.0.bin
KOKORO_VOICE=af_heart
ESPEAK_VOICE=en-us
# Python command. Leave empty for the default: "python" on Windows, "python3" elsewhere.
# Arguments are allowed, e.g. PYTHON=py -3.12 to use Python 3.12 via the Windows launcher.
PYTHON=

# --- Word alignment. "whisper" (faster-whisper, local) or "proportional" ---
ALIGNER=whisper
WHISPER_MODEL=base.en

# --- Rendering ---
# Path to a Chrome/Chromium binary. Leave empty to let Remotion download its own.
BROWSER_EXECUTABLE=
# Parallel render tabs. "auto" ≈ 0.75 × CPU threads (2–12). Lower it if you run out of memory.
RENDER_CONCURRENCY=auto
# OpenGL backend for headless Chromium: angle (default), swiftshader, swangle, egl, vulkan
RENDER_GL=angle
# On-screen host: 3d (toon-shaded game-style character, needs WebGL) or 2d (flat, lighter to render)
PRESENTER=3d
# Optional rigged, textured character (.glb) in models/character/ — e.g. a Quaternius character (free, no credit
# needed) or a Mixamo / Ready Player Me avatar. The first .glb found there is used automatically.
CHARACTER_MODEL=
# Background music: "auto" synthesizes an original copyright-free track per video; "off" disables it.
MUSIC=auto
# Or use your own CC0 / YouTube Audio Library track instead of the generated one:
MUSIC_FILE=

# --- Private repos only (never required for public repos) ---
GITHUB_TOKEN=

# --- Branding: shown as a badge in the bottom-right corner of every video (optional) ---
CHANNEL_NAME=

# --- Web UI ---
PORT=4777
